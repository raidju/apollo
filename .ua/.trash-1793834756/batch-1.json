      "complexity": "moderate"
    },
    {
      "id": "file:src/lodestone/pitch.py",
      "type": "file",
      "name": "pitch.py",
      "filePath": "src/lodestone/pitch.py",
      "summary": "Implements the YIN algorithm for monophonic pitch detection from a NumPy audio frame, returning a PitchReading dataclass with frequency, MIDI note, confidence, and RMS.",
      "tags": ["utility", "audio", "algorithm"],
      "complexity": "moderate",
      "languageNotes": "Pure-NumPy YIN implementation with parabolic interpolation for sub-sample accuracy; no external pitch library dependency."
    },
